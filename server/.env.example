# Required — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/DBNAME
WORKER_AUTH_TOKEN=
ADMIN_AUTH_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=  # CHANGE THIS IN PRODUCTION!

# Sessions (defaults shown)
SESSION_COOKIE_NAME=3dify_session
SESSION_MAX_AGE_DAYS=30

# Optional — defaults shown
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_UPLOAD_BYTES=20971520
RATE_LIMIT_PER_DAY=20
MAX_PENDING_JOBS=50
CORS_ORIGINS=["https://your-domain.com"]

# Worker backend — see server/backends/ and docs/ai-3d-model-generation.md §5
# in the homelab repo. WORKER_BACKEND selects the default; ENABLED_BACKENDS
# controls which ones are instantiated at startup.
WORKER_BACKEND=local
ENABLED_BACKENDS=["local"]
ALLOW_PER_JOB_BACKEND=false

# RunPod Serverless (only needed if ENABLED_BACKENDS includes "runpod")
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_COST_PER_HOUR_USD=1.10
