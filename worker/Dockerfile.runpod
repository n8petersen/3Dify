# RunPod Serverless worker image — GPU generation only, no WebSocket client.
#
# Weights (FLUX.1-dev, Hunyuan3D-2.1 checkpoints) are NOT baked into this image — they live
# on a RunPod network volume mounted at /runpod-volume, populated once via a temporary pod
# (see docs/ai-3d-model-generation.md §10.1 in the homelab repo). Setting HOME=/runpod-volume
# redirects the default `~/.cache/huggingface` and `~/.cache/hy3dgen` cache dirs onto that
# volume, so weights persist across cold starts instead of re-downloading every time.
#
# Layout mirrors the upstream repo root so worker/config.py's relative path resolution
# (_PROJECT_DIR = parent of worker/) and img2stl.py's `Hunyuan3D-2.1/hy3dshape` sys.path entry
# work unmodified: /app/img2stl.py, /app/Hunyuan3D-2.1/, /app/worker/*.py.
#
# Tag verified against Docker Hub (runpod/pytorch) at build-script-writing time — CUDA 12.9 /
# torch 2.8.0 / Ubuntu 22.04. Re-check for a newer tag before building if this has gone stale.
FROM runpod/pytorch:1.3.3-cu1290-torch280-ubuntu2204

ENV HOME=/runpod-volume \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Hunyuan3D-2.1 code only — weights come from the network volume at runtime.
# NOTE: only the hy3dshape sub-pipeline is used (img2stl.py imports
# hy3dshape.pipelines.Hunyuan3DDiTFlowMatchingPipeline directly) — the texture/paint half of
# the repo and its custom CUDA extension builds are not needed and are skipped here.
#
# IMPORTANT: this is Tencent-Hunyuan/Hunyuan3D-2.1, NOT Tencent/Hunyuan3D-2 — the latter is
# the older 2.0 repo and only has a `hy3dgen` module, not `hy3dshape`. Cloning the wrong repo
# here is what produced "ModuleNotFoundError: No module named 'hy3dshape'" on RunPod.
#
# Deliberately install Hunyuan3D-2.1/hy3dshape/requirements.txt (the narrower, unpinned
# requirements file nested inside the repo's hy3dshape/ subdirectory) rather than the repo's
# top-level requirements.txt. The top-level file pins numpy==1.24.4, which has no prebuilt
# wheel for Python 3.12 (this base image's interpreter) and fails building from source
# (pkg_resources/pkgutil.ImpImporter incompatibility). The top-level file also pulls in a pile
# of training-only/texture-pipeline packages (pytorch-lightning, deepspeed, torchdiffeq, timm,
# bpy, cupy-cuda12x, basicsr, realesrgan) that aren't reachable from the inference-only import
# path used here (traced from hy3dshape/pipelines.py). The narrower file omits version pins
# (letting pip resolve Python-3.12-compatible wheels) and already excludes those packages —
# but it comments out scikit-image (actually required — hy3dshape's surface_extractors.py does
# marching-cubes mesh extraction with it) and lists pymeshlab instead of pymeshfix (img2stl.py
# actually imports pymeshfix, a different package) — both added back explicitly below.
RUN git clone --depth 1 https://github.com/Tencent-Hunyuan/Hunyuan3D-2.1.git Hunyuan3D-2.1 \
    && pip install --no-cache-dir -r Hunyuan3D-2.1/hy3dshape/requirements.txt \
    && pip install --no-cache-dir scikit-image pymeshfix

COPY img2stl.py ./
COPY worker/pipeline.py worker/gpu_sampler.py worker/gpu_monitor.py worker/config.py worker/runpod_handler.py worker/requirements-runpod.txt ./worker/

RUN pip install --no-cache-dir -r worker/requirements-runpod.txt

WORKDIR /app/worker
CMD ["python", "-u", "runpod_handler.py"]
